rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 250)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidFriend(data) {
      return data.friendId is string && data.friendId.size() > 0 && data.friendId.size() <= 128 &&
             data.friendUsername is string && data.friendUsername.size() >= 3 && data.friendUsername.size() <= 30 &&
             data.friendDisplayName is string && data.friendDisplayName.size() >= 1 && data.friendDisplayName.size() <= 60 &&
             (!('friendPhotoUrl' in data) || data.friendPhotoUrl == null || (data.friendPhotoUrl is string && data.friendPhotoUrl.size() <= 1000)) &&
             data.addedAt is timestamp && data.addedAt <= request.time;
    }

    function isValidFriendRequest(data) {
      return data.requestId is string && data.requestId.size() > 0 && data.requestId.size() <= 128 &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderUsername is string && data.senderUsername.size() >= 3 && data.senderUsername.size() <= 30 &&
             data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128 &&
             data.receiverUsername is string && data.receiverUsername.size() >= 3 && data.receiverUsername.size() <= 30 &&
             data.status in ['pending', 'accepted', 'declined'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatRoom(data) {
      return data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 128 &&
             data.participants is list && data.participants.size() == 2 &&
             data.participants[0] is string && data.participants[1] is string &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000)) &&
             (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageTimestamp' in data) || (data.lastMessageTimestamp is timestamp && data.lastMessageTimestamp <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMessage(data) {
      return data.messageId is string && data.messageId.size() > 0 && data.messageId.size() <= 128 &&
             data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 128 &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             (!('isRead' in data) || data.isRead is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCallSession(data) {
      return data.callId is string && data.callId.size() > 0 && data.callId.size() <= 128 &&
             data.callerId is string && data.callerId.size() > 0 && data.callerId.size() <= 128 &&
             data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 60 &&
             data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128 &&
             data.receiverName is string && data.receiverName.size() >= 1 && data.receiverName.size() <= 60 &&
             data.channelId is string && data.channelId.size() > 0 && data.channelId.size() <= 128 &&
             data.callType in ['voice', 'video'] &&
             data.status in ['ringing', 'accepted', 'rejected', 'ended'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // --- USERS & FRIENDS ---
    match /users/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'username', 'displayName', 'createdAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'photoUrl', 'phoneNumber', 'bio', 'updatedAt']);

      allow delete: if false;

      match /friends/{friendId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId && isValidFriend(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- FRIEND REQUESTS ---
    match /friendRequests/{requestId} {
      allow get, list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow create: if isSignedIn() &&
                       incoming().senderId == request.auth.uid &&
                       incoming().keys().hasAll(['requestId', 'senderId', 'senderUsername', 'receiverId', 'receiverUsername', 'status', 'createdAt']) &&
                       isValidFriendRequest(incoming());

      allow update: if isSignedIn() &&
                       (existing().receiverId == request.auth.uid || existing().senderId == request.auth.uid) &&
                       isValidFriendRequest(incoming()) &&
                       incoming().senderId == existing().senderId &&
                       incoming().receiverId == existing().receiverId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
    }

    // --- CHATS & MESSAGES ---
    match /chats/{chatId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() &&
                       request.auth.uid in incoming().participants &&
                       incoming().participants.size() == 2 &&
                       incoming().keys().hasAll(['chatId', 'participants', 'createdAt']) &&
                       isValidChatRoom(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid in existing().participants &&
                       isValidChatRoom(incoming()) &&
                       incoming().participants == existing().participants &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt']);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if isSignedIn() &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         incoming().keys().hasAll(['messageId', 'chatId', 'senderId', 'senderName', 'text', 'createdAt']) &&
                         isValidMessage(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         incoming().senderId == existing().senderId &&
                         incoming().chatId == existing().chatId &&
                         incoming().text == existing().text &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);

        allow delete: if false;
      }
    }

    // --- CALLS ---
    match /calls/{callId} {
      allow get, list: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow create: if isSignedIn() &&
                       incoming().callerId == request.auth.uid &&
                       incoming().keys().hasAll(['callId', 'callerId', 'callerName', 'receiverId', 'receiverName', 'channelId', 'callType', 'status', 'createdAt']) &&
                       isValidCallSession(incoming());

      allow update: if isSignedIn() &&
                       (existing().callerId == request.auth.uid || existing().receiverId == request.auth.uid) &&
                       isValidCallSession(incoming()) &&
                       incoming().callerId == existing().callerId &&
                       incoming().receiverId == existing().receiverId &&
                       incoming().channelId == existing().channelId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() && (existing().callerId == request.auth.uid || existing().receiverId == request.auth.uid);
    }
  }
}
